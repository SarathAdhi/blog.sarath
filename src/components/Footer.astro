---
import { GITHUB_URL, PORTFOLIO_URL, SITE_AUTHOR, X_URL } from "../consts";
const year = new Date().getFullYear();
---

<footer
  class="flex items-center justify-between gap-4 border-t border-border px-[max(1.5rem,calc((100%-1180px)/2))] py-8 text-xs text-muted-foreground max-sm:flex-col max-sm:items-start"
>
  <div class="flex items-center gap-4">
    <strong class="font-heading text-sm text-foreground">blog.sarath</strong>
    <span>© {year} {SITE_AUTHOR}</span>
  </div>
  <nav class="flex items-center gap-4" aria-label="Social links">
    <a
      class="no-underline hover:text-foreground"
      href={PORTFOLIO_URL}
      target="_blank"
      rel="noreferrer">Portfolio</a
    >
    <a
      class="no-underline hover:text-foreground"
      href={GITHUB_URL}
      target="_blank"
      rel="noreferrer">GitHub</a
    >
    <a
      class="no-underline hover:text-foreground"
      href={X_URL}
      target="_blank"
      rel="noreferrer">X</a
    >
  </nav>
</footer>
