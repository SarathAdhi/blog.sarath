---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  mainClass?: string;
}

const {
  title,
  description,
  image,
  mainClass = "mx-auto w-[calc(100%-3rem)] max-w-280 max-md:w-[calc(100%-2rem)]",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="min-w-80 bg-background text-foreground">
    <Header />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
