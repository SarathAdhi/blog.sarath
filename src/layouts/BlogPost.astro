---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];
const { title, description, pubDate, updatedDate, heroImage, author, tags } =
  Astro.props;
---

<html lang="en" class="font-sans">
  <head><BaseHead title={title} description={description} /></head>
  <body class="min-w-80 bg-background text-foreground">
    <Header />
    <main
      class="mx-auto w-[calc(100%-3rem)] max-w-280 py-16 max-md:w-[calc(100%-2rem)] max-md:py-10"
    >
      <a
        class="text-xs text-muted-foreground no-underline hover:text-foreground"
        href="/">&lt;- Back to all notes</a
      >
      <header class="px-0 pb-12 pt-20 text-center max-md:pb-10 max-md:pt-16">
        <div class="flex justify-center gap-2 text-xs text-muted-foreground">
          <FormattedDate date={pubDate} /><span>-</span>{author}
        </div>
        <h1
          class="mb-4 mt-5 font-heading text-[clamp(2.6rem,7vw,5.5rem)] font-semibold leading-[0.95] tracking-[-0.07em]"
        >
          {title}
        </h1><p
          class="mx-auto max-w-136 text-base leading-7 text-muted-foreground"
        >
          {description}
        </p>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {
            tags.map((tag) => (
              <span class="rounded-full border border-border px-2 py-1 text-[0.65rem] text-muted-foreground">
                {tag}
              </span>
            ))
          }
        </div>
      </header>
      {
        heroImage && (
          <Image
            class="block w-full rounded-lg"
            width={1200}
            height={600}
            src={heroImage}
            alt=""
          />
        )
      }
      <article
        class="prose prose-neutral dark:prose-invert mx-auto mt-16 max-w-170 prose-headings:font-heading prose-headings:tracking-tight prose-a:text-foreground prose-img:rounded-md max-md:mt-10 max-md:text-base"
      >
        <slot />{
          updatedDate && (
            <p class="not-prose mt-12 text-xs italic text-muted-foreground">
              Last updated on <FormattedDate date={updatedDate} />
            </p>
          )
        }
      </article>
    </main>
    <Footer />
  </body>
</html>
